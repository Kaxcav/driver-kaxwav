<?xml version="1.0" encoding="utf-8"?>
<!-- Lean WPR profile for the ExclusivePro cadence diagnosis: scheduler (CSwitch/ReadyThread/priority),
     DPC/ISR and Microsoft-Windows-Audio. No stacks, no sampling: small enough to dump with tracerpt. -->
<WindowsPerformanceRecorder Version="1.0" Author="KaxWav">
  <Profiles>
    <SystemCollector Id="SC_UM2" Name="NT Kernel Logger">
      <BufferSize Value="1024"/>
      <Buffers Value="512"/>
    </SystemCollector>
    <EventCollector Id="EC_UM2" Name="UM2 Event Collector">
      <BufferSize Value="1024"/>
      <Buffers Value="128"/>
    </EventCollector>
    <SystemProvider Id="SP_UM2">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="CSwitch"/>
        <Keyword Value="ReadyThread"/>
        <Keyword Value="DPC"/>
        <Keyword Value="Interrupt"/>
        <Keyword Value="ThreadPriority"/>
      </Keywords>
    </SystemProvider>
    <EventProvider Id="EP_Audio" Name="AE4BD3BE-F36F-45B6-8D21-BDD6FB832853" Level="5"/>
    <Profile Id="UM2Sched.Verbose.File" Name="UM2Sched" Description="UM2 ExclusivePro cadence" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SC_UM2">
          <SystemProviderId Value="SP_UM2"/>
        </SystemCollectorId>
        <EventCollectorId Value="EC_UM2">
          <EventProviders>
            <EventProviderId Value="EP_Audio"/>
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
